@echo off
chcp 65001 > nul
title 一键同步笔记

echo ======================================
echo     正在同步笔记到 GitHub...
echo ======================================
echo.

:: 进入当前目录（脚本必须放在笔记根目录）
cd /d "%~dp0"

:: 1. 添加所有修改
git add .

:: 2. 提交（自动生成时间戳作为备注）
git commit -m "LowenAtkinson: %date% %time%"

:: 3. 推送到远程仓库
git push

echo.
echo ======================================
echo     ✅ 同步完成！按任意键关闭窗口
echo ======================================
pause > nul